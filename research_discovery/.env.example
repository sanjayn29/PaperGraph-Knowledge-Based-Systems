# Gemini API key (required for LLM stages: CREF evaluation & GIC insight generation)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the default Gemini model (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash
